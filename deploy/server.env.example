# 三个域名都需要把 DNS A/AAAA 记录指向同一台服务器。
PORTAL_DOMAIN=
STOCK_DOMAIN=
FOOTBALL_DOMAIN=

# 只填写根域名，不要带协议、端口、路径或开头的点。
COOKIE_DOMAIN=

# 入口访问密钥至少 12 位；建议使用 `openssl rand -hex 16` 生成。
SITE_ACCESS_KEY=

# 使用 `openssl rand -hex 32` 生成，不能和 SITE_ACCESS_KEY 相同。
PORTAL_SESSION_SECRET=

# 股票应用的 AI 配置；不使用的供应商可以留空。
STOCK_DEEPSEEK_API_KEY=
STOCK_DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# 足球应用的 DeepSeek 配置，可以和股票应用使用不同的 Key。
FOOTBALL_DEEPSEEK_API_KEY=

# A股行情、策略和每日任务参数。
SPOT_CACHE_SECONDS=900
PRIMARY_FAILURE_BACKOFF_SECONDS=1800
EASTMONEY_DELAY_ENABLED=true
EASTMONEY_PAGE_DELAY_SECONDS=0.25
EASTMONEY_DELAY_HOSTS=
STRATEGY_SAMPLE_SIZE=18
HOT_CONCEPT_LIMIT=5
ENABLE_DAILY_SCHEDULER=true
DAILY_RUN_HOUR=18
DAILY_RUN_MINUTE=10
DAILY_RUN_SECRET=
