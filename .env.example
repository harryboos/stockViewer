# 本地数据服务（通常无需修改）
STOCK_BACKEND_URL=http://127.0.0.1:8000
STOCK_BACKEND_PORT=8000
STOCK_VIEWER_DB=./data/stockviewer.sqlite3

# 免费行情缓存与每日策略
SPOT_CACHE_SECONDS=900
PRIMARY_FAILURE_BACKOFF_SECONDS=1800
EASTMONEY_DELAY_ENABLED=true
EASTMONEY_PAGE_DELAY_SECONDS=0.25
# 可选：上游域名再次变化时，用逗号分隔填写备用域名
EASTMONEY_DELAY_HOSTS=
STRATEGY_SAMPLE_SIZE=18
HOT_CONCEPT_LIMIT=5
ENABLE_DAILY_SCHEDULER=true
DAILY_RUN_HOUR=18
DAILY_RUN_MINUTE=10

# 每日 AI 选股
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GLM_API_KEY=
GLM_MODEL=glm-5.3
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max
# 新版百炼工作空间可替换为控制台提供的专属 compatible-mode/v1 地址。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：保护外部触发每日策略的接口
DAILY_RUN_SECRET=
